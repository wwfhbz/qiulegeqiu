{
  "name": "qiulegeqiu-wechat-game",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && node scripts/build.mjs",
    "dev": "npm run typecheck && node scripts/build.mjs --dev",
    "test": "npm run build && node --test scripts/build.test.mjs",
    "release": "npm run typecheck && node scripts/build.mjs --release",
    "test:browser": "npm run build && node scripts/browser-test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
