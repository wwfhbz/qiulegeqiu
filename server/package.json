{
  "name": "qiulegeqiu-api",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node build/index.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && esbuild src/index.ts src/manage.ts --bundle --platform=node --format=esm --packages=external --outdir=build",
    "test": "vitest run --config vitest.config.ts",
    "migrate": "tsx src/manage.ts migrate",
    "admin": "tsx src/manage.ts",
    "regions:check": "tsx src/regions.ts --check"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "@fastify/cookie": "^11.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "esbuild": "^0.25.0"
  }
}
