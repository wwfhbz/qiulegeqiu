NODE_ENV=production
PORT=8091
PUBLIC_ORIGIN=https://ball.gmgnclaw.com
DB_PATH=/var/lib/qiulegeqiu/leaderboard.sqlite
# APP_ROOT is the server directory containing data/ and migrations/.
# APP_ROOT=/opt/qiulegeqiu-api/current/server
# Optional private HTTPS moderation gateway, never VITE_ prefixed.
# MODERATION_URL=https://your-private-moderation-gateway.example/check
# MODERATION_API_KEY=
# Optional WeChat minigame login. Configure BOTH on server only; absent => HTTP 503, offline works.
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
