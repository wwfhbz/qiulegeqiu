{
  "name": "ball-core",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "test:browser": "node tests/browser-v02.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser:arcade": "node tests/browser-arcade.mjs",
    "test:browser:layout": "node tests/browser-v031.mjs",
    "test:browser:central": "node tests/browser-central-start.mjs",
    "test:browser:exit": "node tests/browser-exit.mjs",
    "test:browser:death": "node tests/browser-death-zone.mjs",
    "test:browser:ui": "node tests/browser-minimal-ui.mjs",
    "test:browser:lives": "node tests/browser-lives-balance.mjs",
    "api:dev": "npm run dev --prefix server",
    "api:test": "npm test --prefix server",
    "api:build": "npm run build --prefix server",
    "regions:update": "node scripts/update-regions.mjs",
    "regions:check": "npm run regions:check --prefix server",
    "test:browser:leaderboard": "node tests/browser-leaderboard.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.6",
    "i18n-iso-countries": "^7.14.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
