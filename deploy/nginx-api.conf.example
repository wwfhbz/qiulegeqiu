# Only insert into the EXISTING ball.gmgnclaw.com HTTPS server block.
# Do not replace the server block, certificate settings or other sites.
location ^~ /api/ {
    proxy_pass http://127.0.0.1:8091;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 15s;
    client_max_body_size 256k;
    # Optional: first define the named zone in http {}, see DEPLOYMENT_V07.md.
    # limit_req zone=qiulegeqiu_api burst=30 nodelay;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
}
